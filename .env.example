# DISCORD_TOKEN: The bot token for NotABot (the personality bot).
# Get this from the Discord Developer Portal.
DISCORD_TOKEN="YOUR_NOTABOT_TOKEN"

# BUSINESS_BOT_TOKEN: The bot token for BusinessBot (the economy game bot).
# Create a SECOND bot application on the Discord Developer Portal and paste its token here.
# Without this, BusinessBot will show as Offline and the economy game will not work.
BUSINESS_BOT_TOKEN="YOUR_BUSINESSBOT_TOKEN"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE_PROJECT_ID: The project ID for Firebase Admin SDK.
FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL: The client email for Firebase Admin SDK.
FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY: The private key for Firebase Admin SDK.
FIREBASE_PRIVATE_KEY=

# YT_CLIENT_ID, YT_CLIENT_SECRET, YT_REFRESH_TOKEN: Optional.
# Required only if you want the bot to watch your YouTube channel for new uploads.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=

# DISCORD_CLIENT_ID, DISCORD_CLIENT_SECRET: Required for the Web Dashboard OAuth2 login.
# Add your Discord Application's Client ID and Secret from the Developer Portal.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

