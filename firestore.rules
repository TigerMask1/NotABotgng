rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Server-side environment check: Since this is a server-side bot using client SDK without explicit auth,
    // we allow public access for now BUT we should stick to strict keys and sizes.
    // In a prod app, you'd use Firebase Admin or Auth to secure this.

    match /servers/{guildId} {
      allow get: if isValidId(guildId);
      allow list: if false; // No blanket listing
      
      allow create, update: if isValidId(guildId) &&
        request.resource.data.keys().hasAll(['updatedAt']) &&
        request.resource.data.updatedAt is string;

      match /users/{userId} {
        allow get: if isValidId(userId);
        allow list: if false;

        allow create, update: if isValidId(userId) &&
          request.resource.data.keys().hasAll(['updatedAt']);
      }
    }
  }
}
