rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Servers and users
    // This bot is designed to be managed via server-side logic (Express).
    // If we wanted the dashboard to read directly, we would add rules here.
    // For now, only the server needs access. 
    // In many cases, using the client SDK on a server-side environment (like this)
    // results in the request being authenticated if the environment has credentials,
    // but here we are using the public config.
    
    match /servers/{guildId} {
      allow read, write: if true; // In a real app, restrict this to the bot's service account or admin
      
      match /users/{userId} {
        allow read, write: if true;
      }
    }
  }
}
