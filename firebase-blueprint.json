{
  "entities": {
    "ServerConfig": {
      "title": "Server Config",
      "description": "Configuration and state for a specific Discord server",
      "type": "object",
      "properties": {
        "guildId": { "type": "string" },
        "name": { "type": "string" },
        "lastSummary": { "type": "string" },
        "insideJokes": {
          "type": "array",
          "items": { "type": "string" }
        },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["guildId", "updatedAt"]
    },
    "UserMemory": {
      "title": "User Memory",
      "description": "Information the bot remembers about a specific user in a server",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "guildId": { "type": "string" },
        "nicknames": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "traits": { 
          "type": "array",
          "items": { "type": "string" }
        },
        "lastInteractions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "vibe": { "type": "string" }
      },
      "required": ["userId", "guildId"]
    }
  },
  "firestore": {
    "servers/{guildId}": {
      "schema": "ServerConfig",
      "description": "General server configuration and state"
    },
    "servers/{guildId}/users/{userId}": {
      "schema": "UserMemory",
      "description": "Contextual memory about a user in a specific server"
    }
  }
}
